# Dedicated PostgreSQL database on the same VPS. Keep the server bound to localhost.
DATABASE_URL="postgresql://soplol_app:REPLACE_WITH_PASSWORD@127.0.0.1:5432/soplol_store?schema=public"

# Direct connection for Prisma migrations (same local PostgreSQL instance; no pooler).
DIRECT_URL="postgresql://soplol_app:REPLACE_WITH_PASSWORD@127.0.0.1:5432/soplol_store?schema=public"

# Optional: SSLCommerz credentials are required before online checkout is enabled.
# Set APP_URL to the public HTTPS URL and keep these credentials server-side only.
APP_URL="https://soplol.com"
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_LIVE="false"
